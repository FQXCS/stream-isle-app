# ===== 依赖 =====
node_modules/

# ===== Expo / React Native =====
.expo/
.expo-shared/
*.tsbuildinfo
.metro-health-check*
dist/
web-build/
expo-env.d.ts

# ===== Android（android/ 为 prebuild 产物，入库；仅忽略本地与构建产物）=====
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.cxx/
android/*.hprof
.kotlin/

# ===== 本地模块（modules/）构建产物 =====
modules/*/android/build/

# ===== Android Studio / IntelliJ（android/ 单独打开时生成）=====
android/.idea/
*.iml

# 密钥文件严禁入库（debug.keystore 缺失时 gradle 会自动生成）
*.keystore
!debug.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ===== iOS（当前仅 Android，后置阶段使用；prebuild ios 后按需放开）=====
# TV-m0 双工程：/mobile/ios（手机）、/tv/ios（TV），其余 android/ 等无前导斜杠模式自动匹配任意层级
/mobile/ios
/tv/ios

# ===== 环境变量 / 密钥 =====
.env
.env.*
!.env.example

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== IDE / 工具 =====
.idea/
.vscode/*
!.vscode/extensions.json
.zcode/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
Desktop.ini
/docs/

# ===== M6 发布签名（06 文档 §4.9.1：keystore 即身份，文件与口令严禁入库）=====
android/keystore.properties
android/keystores/
release.keystore
/.dsh*
/.qoder

# ===== 本地打包 JS bundle 调试产物（不入库；真机联调时临时打入）=====
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable*/assets_icon.png
android/app/src/main/res/drawable*/node_modules_*
android/app/src/main/res/raw/
