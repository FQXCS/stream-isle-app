{
  // 直接 extends expo/tsconfig.base（tv/node_modules 可解析），不链经 ../mobile/tsconfig.json：
  // 该链在 CI tv job 断链——job 只装 tv 依赖，mobile/node_modules 不存在，expo 无法从 mobile/
  // 解析，eslint import resolver（get-tsconfig）与 tsc 均报错。代价：mobile/tsconfig.json 的
  // compilerOptions 变更须同步本文件（原「paths 整体覆盖」义务扩大为「继承字段全量同步」）。
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // types 不继承 mobile 的 ["jest"]：tv 侧不装 jest（共享层单测归 mobile job，TV-m0 §4.8）；
    // node 供 metro.config.ts 的 CJS 全局（__dirname/require/module）类型
    "types": ["node"],
    // paths 显式声明（extends 不合并）：@/ 指共享层（相对本文件解析，等价 mobile 语义）、
    // @tv/ 指 TV 层；深引用映射同 mobile 口径（fork 的 types_generated 路径实测确认存在）。
    // 相对路径按声明本文件的 tv/ 解析（TS 5+ paths 不随 extends 改基）
    "paths": {
      "@/*": ["../mobile/src/*"],
      "@tv/*": ["./src/*"],
      "phosphor-react-native/src/icons/*": ["./node_modules/phosphor-react-native/lib/typescript/icons/*"],
      "react-native/Libraries/Types/CodegenTypes": ["./node_modules/react-native/types_generated/Libraries/Types/CodegenTypes.d.ts"],
      // modules/ 本地模块源码内 import expo-modules-core（TV-m0 平移定案，同 mobile/tsconfig 条目）
      "expo-modules-core": ["./node_modules/expo-modules-core"]
    }
  }
}
