+package com.brentvatne.exoplayer;
+
+import android.content.Context;
+import androidx.annotation.OptIn;
+import androidx.media3.common.audio.AudioProcessor;
+import androidx.media3.common.util.UnstableApi;
+import androidx.media3.exoplayer.DefaultRenderersFactory;
+import androidx.media3.exoplayer.audio.AudioSink;
+import androidx.media3.exoplayer.audio.DefaultAudioSink;
+
+/**
+ * 带音频延迟的渲染器工厂（M8 音画同步延时）：经 DefaultAudioSink.Builder.setAudioProcessors
+ * 向 PCM 处理器链注入 {@link AudioDelayProcessor}；其余构建参数镜像 DefaultRenderersFactory 默认实现。
+ * passthrough/offload 模式处理器链被 media3 整体 bypass（本 app 默认不开启）。
+ */
+@OptIn(markerClass = UnstableApi.class)
+public class DelayRenderersFactory extends DefaultRenderersFactory {
+
+    /** 音频延迟处理器（随工厂实例生命周期，View 经 getter 实时写偏移） */
+    private final AudioDelayProcessor audioDelayProcessor = new AudioDelayProcessor();
+
+    public DelayRenderersFactory(Context context) {
+        super(context);
+    }
+
+    /**
+     * 暴露处理器实例供 View 的 audioDelayMs prop 实时写入。
+     *
+     * @return 本工厂注入处理器链的音频延迟处理器
+     */
+    public AudioDelayProcessor getAudioDelayProcessor() {
+        return audioDelayProcessor;
+    }
+
+    @Override
+    protected AudioSink buildAudioSink(
+            Context context, boolean enableFloatOutput, boolean enableAudioOutputPlaybackParams) {
+        return new DefaultAudioSink.Builder(context)
+                .setEnableFloatOutput(enableFloatOutput)
+                .setEnableAudioOutputPlaybackParameters(enableAudioOutputPlaybackParams)
+                .setAudioProcessors(new AudioProcessor[] {audioDelayProcessor})
+                .build();
+    }
+}
