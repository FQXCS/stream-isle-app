+package com.brentvatne.exoplayer;
+
+import androidx.annotation.OptIn;
+import androidx.media3.common.C;
+import androidx.media3.common.audio.AudioProcessor;
+import androidx.media3.common.util.UnstableApi;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/**
+ * 音频延迟处理器（M8 音画同步延时）：PCM 层插静音（正延迟=音频延后）或丢前导样本
+ * （负延迟=音频提前），实现音频相对视频的偏移；ExoPlayer 以音频为主时钟，偏移真实生效。
+ * 仅 PCM_16BIT 生效，其余格式（float/passthrough 等）原样透传不处理。
+ * flush（seek/切轨）按绝对偏移重 arm 保证 seek 后语义；流中 setDelayUs 按增量即时生效。
+ */
+@OptIn(markerClass = UnstableApi.class)
+public class AudioDelayProcessor implements AudioProcessor {
+
+    /** 微秒→秒换算基数 */
+    private static final long MICROS_PER_SECOND = 1_000_000L;
+
+    /** 16-bit PCM 每样本字节数 */
+    private static final int BYTES_PER_SAMPLE = 2;
+
+    /** 空输出缓冲（复用避免重复分配） */
+    private static final ByteBuffer EMPTY_BUFFER =
+            ByteBuffer.allocateDirect(0).order(ByteOrder.nativeOrder());
+
+    /** 绝对偏移（微秒）：正=延后，负=提前 */
+    private long delayUs;
+
+    /** 仅 PCM_16BIT 配置成功后为 true */
+    private boolean active;
+
+    /** 当前流采样率（configure 回填） */
+    private int sampleRate;
+
+    /** 每帧字节数 = 声道数 * 2（configure 回填） */
+    private int bytesPerFrame;
+
+    /** 待插静音字节数（正延迟） */
+    private long pendingSilenceBytes;
+
+    /** 待丢样本字节数（负延迟） */
+    private long pendingSkipBytes;
+
+    /** 已 queueEndOfStream 且输出排空后 isEnded 为 true */
+    private boolean endOfStreamQueued;
+
+    /** 本次 queueInput 的处理结果 */
+    private ByteBuffer outputBuffer = EMPTY_BUFFER;
+
+    @Override
+    public AudioFormat configure(AudioFormat inputAudioFormat) throws UnhandledAudioFormatException {
+        if (inputAudioFormat.encoding != C.ENCODING_PCM_16BIT) {
+            // 非 PCM_16BIT（float/passthrough 等）不处理，交回原格式
+            active = false;
+            return inputAudioFormat;
+        }
+        active = true;
+        sampleRate = inputAudioFormat.sampleRate;
+        bytesPerFrame = inputAudioFormat.channelCount * BYTES_PER_SAMPLE;
+        rearm();
+        return inputAudioFormat;
+    }
+
+    @Override
+    public boolean isActive() {
+        return active;
+    }
+
+    @Override
+    public void queueInput(ByteBuffer inputBuffer) {
+        int remaining = inputBuffer.remaining();
+        // 负延迟：先丢前导样本
+        if (pendingSkipBytes > 0) {
+            int skip = (int) Math.min(pendingSkipBytes, remaining);
+            inputBuffer.position(inputBuffer.position() + skip);
+            pendingSkipBytes -= skip;
+            remaining = inputBuffer.remaining();
+        }
+        // 正延迟：输出头部补静音（allocateDirect 零初始化，静音段无需显式写）
+        int silenceBytes = (int) Math.min(pendingSilenceBytes, Integer.MAX_VALUE - remaining);
+        if (silenceBytes == 0 && remaining == 0) {
+            outputBuffer = EMPTY_BUFFER;
+            return;
+        }
+        ByteBuffer buffer =
+                ByteBuffer.allocateDirect(silenceBytes + remaining).order(ByteOrder.nativeOrder());
+        buffer.position(silenceBytes);
+        buffer.put(inputBuffer);
+        buffer.flip();
+        pendingSilenceBytes -= silenceBytes;
+        outputBuffer = buffer;
+    }
+
+    @Override
+    public void queueEndOfStream() {
+        endOfStreamQueued = true;
+    }
+
+    @Override
+    public ByteBuffer getOutput() {
+        ByteBuffer buffer = outputBuffer;
+        outputBuffer = EMPTY_BUFFER;
+        return buffer;
+    }
+
+    @Override
+    public boolean isEnded() {
+        return endOfStreamQueued && outputBuffer.remaining() == 0;
+    }
+
+    @Override
+    public void flush(StreamMetadata streamMetadata) {
+        // seek/切轨：按绝对偏移重 arm（视频回到 t 时音频应 heard t-delay）
+        rearm();
+        outputBuffer = EMPTY_BUFFER;
+        endOfStreamQueued = false;
+    }
+
+    @Override
+    public void reset() {
+        active = false;
+        pendingSilenceBytes = 0;
+        pendingSkipBytes = 0;
+        outputBuffer = EMPTY_BUFFER;
+        endOfStreamQueued = false;
+    }
+
+    /**
+     * 设置绝对偏移（微秒）。流中调用按增量插静音/丢样本即时生效（下游已缓冲 PCM
+     * 排空后可闻，约 100–500ms）；未配置时仅记录，configure/flush 时重 arm。
+     *
+     * @param delayUs 绝对偏移微秒数，正=音频延后，负=音频提前
+     */
+    public void setDelayUs(long delayUs) {
+        long deltaUs = delayUs - this.delayUs;
+        this.delayUs = delayUs;
+        if (!active) {
+            return;
+        }
+        if (deltaUs > 0) {
+            pendingSilenceBytes += usToBytes(deltaUs);
+        } else if (deltaUs < 0) {
+            pendingSkipBytes += usToBytes(-deltaUs);
+        }
+    }
+
+    /** 按绝对偏移重 arm 待插/待丢字节数 */
+    private void rearm() {
+        pendingSilenceBytes = delayUs > 0 ? usToBytes(delayUs) : 0;
+        pendingSkipBytes = delayUs < 0 ? usToBytes(-delayUs) : 0;
+    }
+
+    /** 微秒→字节（按帧对齐，避免半帧撕裂） */
+    private long usToBytes(long us) {
+        long frames = us * sampleRate / MICROS_PER_SECOND;
+        return frames * bytesPerFrame;
+    }
+}
