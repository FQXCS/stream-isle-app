{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      // @rntp/player 深引用 RN 内部类型；RN 0.88 exports 不再为该路径提供类型（types: null），
      // 指向 types_generated 声明（"." 主入口的 types 分支同源）
      "react-native/Libraries/Types/CodegenTypes": ["./node_modules/react-native/types_generated/Libraries/Types/CodegenTypes.d.ts"]
    }
  }
}
